{
  "name": "client-manager",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "homepage": "./",
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4",
    "yaml": "^2.8.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "node scripts/start-electron.js",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm start\" \"wait-on http://localhost:3000 && node scripts/start-electron.js\"",
    "electron:build": "npm run build:electron && electron-builder --win --publish never",
    "electron:build:mac": "npm run build:electron && electron-builder --mac --publish never",
    "electron:publish": "npm run build:electron && electron-builder --win --publish always",
    "build:electron": "cross-env GENERATE_SOURCEMAP=false react-scripts build",
    "electron:icon": "node scripts/start-electron.js scripts/make-icon.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.clientmanager.app",
    "productName": "Client Manager",
    "copyright": "Copyright © 2026 Hanaa Makhlouf",
    "extends": null,
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "directories": {
      "output": "dist",
      "buildResources": "buildResources"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "buildResources/icon.png",
      "!**/node_modules/**/*"
    ],
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "HanaaMakhlouf",
        "repo": "archi-crm",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "buildResources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Client Manager"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business",
      "icon": "buildResources/icon.png"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  },
  "description": "משרד פלוס – office and client management",
  "author": "Hanaa Makhlouf"
}
